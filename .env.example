# URL canonique du site. Laisser vide tant que reflexesur-blog.pages.dev est utilisé.
SITE_URL=https://reflexesur-blog.pages.dev

# À renseigner dans Cloudflare après création de la propriété Search Console.
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Passer à true uniquement le jour où un service optionnel de mesure/publicité est réellement activé.
# Le bandeau de consentement est déjà prêt et reste invisible tant que cette valeur vaut false.
PUBLIC_TRACKING_ENABLED=false
