---
const {
  title = 'Réflexe Sûr',
  description = 'Des guides vérifiés pour reconnaître les arnaques, protéger ses comptes et son argent.',
  type = 'website',
  noindex = false
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const siteName = 'Réflexe Sûr';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  url: Astro.site?.toString(),
  description: 'Guides pratiques et vérifiés sur les arnaques et la protection numérique.',
  inLanguage: 'fr-FR'
};
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f766e" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <slot name="head" />

    <style is:global>
      :root {
        --ink: #172125;
        --muted: #617078;
        --brand: #0f766e;
        --brand-dark: #0b5f59;
        --mint: #e9f7f3;
        --cream: #fff9ec;
        --line: #dce6e4;
        --soft: #f5f8f7;
        --danger: #b42318;
        --max: 1120px;
        --shadow: 0 14px 38px rgba(27, 62, 58, 0.08);
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        color: var(--ink);
        line-height: 1.65;
        background: #fff;
        -webkit-font-smoothing: antialiased;
      }
      a { color: var(--brand); text-underline-offset: 3px; }
      button, input { font: inherit; }
      img { max-width: 100%; }
      .wrap { width: min(var(--max), calc(100% - 36px)); margin-inline: auto; }

      header {
        position: sticky;
        top: 0;
        z-index: 20;
        background: rgba(255,255,255,.92);
        border-bottom: 1px solid var(--line);
        backdrop-filter: blur(12px);
      }
      nav {
        min-height: 68px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--ink);
        font-weight: 900;
        text-decoration: none;
        letter-spacing: -.02em;
      }
      .mark {
        width: 40px;
        height: 40px;
        border-radius: 13px;
        display: grid;
        place-items: center;
        color: #fff;
        background: var(--brand);
        box-shadow: 0 8px 22px rgba(15,118,110,.18);
      }
      .links { display: flex; align-items: center; gap: 22px; }
      .links a { color: var(--ink); text-decoration: none; font-weight: 750; font-size: .95rem; }
      .links a:hover { color: var(--brand); }

      h1, h2, h3 { line-height: 1.12; letter-spacing: -.035em; }
      h1 { font-size: clamp(2.3rem, 4.6vw, 4rem); margin: .35em 0; }
      h2 { font-size: clamp(1.75rem, 3vw, 2.45rem); margin: 0 0 .65em; }
      h3 { margin: .65em 0 .45em; }
      .lead { font-size: 1.12rem; color: #45575f; max-width: 760px; }
      .pill, .badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: #fff;
        border: 1px solid var(--line);
        padding: 7px 12px;
        border-radius: 999px;
        color: var(--brand);
        font-weight: 850;
        font-size: .82rem;
      }

      section { padding: 58px 0; }
      .soft { background: var(--soft); }
      .pagehero {
        padding: 56px 0 48px;
        background: linear-gradient(135deg, #eef9f5, #fff9ec);
        border-bottom: 1px solid #eef1ef;
      }
      .pagehero h1 { max-width: 900px; }

      .section-head {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 24px;
      }
      .section-head p { margin: 0; color: var(--muted); }

      .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
      .card {
        min-width: 0;
        border: 1px solid var(--line);
        border-radius: 18px;
        padding: 21px;
        background: #fff;
        box-shadow: var(--shadow);
      }
      .card h3 { font-size: 1.14rem; }
      .card h3 a { color: var(--ink); text-decoration: none; }
      .card h3 a:hover { color: var(--brand); }
      .card p { color: var(--muted); }
      .cat {
        display: inline-block;
        font-size: .73rem;
        text-transform: uppercase;
        letter-spacing: .08em;
        font-weight: 900;
        color: var(--brand);
      }
      .meta { color: var(--muted); font-size: .9rem; }

      .grid4 { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
      .topic {
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 18px;
        background: #fff;
      }
      .topic b { display: block; margin: 6px 0 2px; }
      .topic span { color: var(--muted); font-size: .92rem; }

      .category-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
      .category-card {
        display: block;
        padding: 22px;
        border: 1px solid var(--line);
        border-radius: 18px;
        background: white;
        color: var(--ink);
        text-decoration: none;
        box-shadow: var(--shadow);
      }
      .category-card:hover { border-color: #a8cfca; transform: translateY(-1px); }
      .category-card strong { display: block; margin-bottom: 4px; }
      .category-card span { color: var(--muted); }

      .article-grid { display: grid; grid-template-columns: minmax(0, 760px) 280px; gap: 48px; align-items: start; }
      .content { font-size: 1.05rem; }
      .content h2 { font-size: 1.7rem; margin-top: 2.1em; }
      .content h3 { margin-top: 1.7em; }
      .content p, .content li { max-width: 72ch; }
      .content a { font-weight: 650; }
      .content blockquote { margin: 1.5em 0; padding: 16px 18px; background: var(--soft); border-left: 4px solid var(--brand); }
      .alert { background: var(--mint); border-left: 5px solid var(--brand); padding: 17px; border-radius: 12px; margin: 22px 0; }
      .danger { background: #fff0ee; border-color: var(--danger); }
      .side { position: sticky; top: 92px; }
      .sidebox, .ad { border: 1px solid var(--line); border-radius: 15px; padding: 17px; margin-bottom: 15px; background: #fff; }
      .ad { text-align: center; color: var(--muted); border-style: dashed; font-size: .88rem; }
      .article-meta { display: flex; flex-wrap: wrap; gap: 10px 18px; color: var(--muted); font-size: .9rem; }

      .notice {
        border: 1px solid #f0d69a;
        background: #fffaf0;
        border-radius: 14px;
        padding: 15px 17px;
        color: #5d4b1f;
      }

      footer { background: #10181c; color: #d8e1e4; padding: 42px 0 22px; }
      .foot { display: grid; grid-template-columns: 1.3fr .8fr .8fr; gap: 30px; }
      .foot a { color: #d8e1e4; }
      .foot ul { list-style: none; padding: 0; margin: 10px 0 0; }
      .foot li { margin: 6px 0; }
      .foot-note { border-top: 1px solid #2a383d; margin-top: 28px; padding-top: 18px; color: #91a0a6; font-size: .82rem; }

      @media (max-width: 900px) {
        .cards, .category-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .grid4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .article-grid { grid-template-columns: 1fr; }
        .side { position: static; }
      }
      @media (max-width: 660px) {
        .links { display: none; }
        .cards, .category-grid, .grid4, .foot { grid-template-columns: 1fr; }
        section { padding: 44px 0; }
        .pagehero { padding: 42px 0 36px; }
        .section-head { align-items: start; flex-direction: column; }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="wrap">
        <nav aria-label="Navigation principale">
          <a class="brand" href="/" aria-label="Réflexe Sûr — accueil"><span class="mark">✓</span><span>Réflexe Sûr</span></a>
          <div class="links">
            <a href="/articles">Guides</a>
            <a href="/categories">Catégories</a>
            <a href="/a-propos">À propos</a>
          </div>
        </nav>
      </div>
    </header>

    <main><slot /></main>

    <footer>
      <div class="wrap">
        <div class="foot">
          <div>
            <a class="brand" href="/" style="color:white"><span class="mark">✓</span><span>Réflexe Sûr</span></a>
            <p>Des guides pratiques et vérifiés pour reconnaître les arnaques et protéger ses comptes.</p>
          </div>
          <div>
            <b>Explorer</b>
            <ul>
              <li><a href="/articles">Tous les guides</a></li>
              <li><a href="/categories">Catégories</a></li>
            </ul>
          </div>
          <div>
            <b>Informations</b>
            <ul>
              <li><a href="/a-propos">À propos</a></li>
              <li><a href="/contact">Contact</a></li>
              <li><a href="/mentions-legales">Mentions légales</a></li>
              <li><a href="/confidentialite">Confidentialité</a></li>
            </ul>
          </div>
        </div>
        <div class="foot-note">© {new Date().getFullYear()} Réflexe Sûr — Informations pédagogiques fondées sur des sources identifiées.</div>
      </div>
    </footer>
  </body>
</html>
