---
const { articles = [] } = Astro.props;
const searchArticles = articles.map((article) => ({
  id: article.id,
  title: article.data.title,
  description: article.data.description,
  category: article.data.category,
  tags: article.data.tags ?? []
}));
---
<section class="hero-search" id="recherche">
  <div class="hero-content">
    <span class="badge">✓ Comprendre avant d'agir</span>
    <h1>Les bons réflexes contre les arnaques.</h1>
    <p>Un message, un appel ou un site vous paraît suspect ? Recherchez le sujet et retrouvez les vérifications à faire avant d'agir.</p>

    <form class="search-box" id="search-form" role="search">
      <input id="search-input" type="search" placeholder="Ex. colis, banque, mot de passe…" autocomplete="off" aria-label="Rechercher un guide" />
      <button type="submit">Rechercher</button>
    </form>

    <div class="popular-searches" aria-label="Recherches populaires">
      <span>Recherches :</span>
      <button type="button" class="popular-search" data-search="colis">Colis</button>
      <button type="button" class="popular-search" data-search="banque">Banque</button>
      <button type="button" class="popular-search" data-search="compte piraté">Compte piraté</button>
    </div>

    <div id="search-results" class="search-results" hidden aria-live="polite"></div>
  </div>
</section>

<script define:vars={{ searchArticles }}>
  const input = document.querySelector('#search-input');
  const form = document.querySelector('#search-form');
  const results = document.querySelector('#search-results');
  const popularButtons = document.querySelectorAll('.popular-search');

  const intentAliases = new Map([
    ['compte pirate', ['pirate', 'piratage', 'mot de passe', 'authentification', '2fa']],
    ['compte piraté', ['pirate', 'piratage', 'mot de passe', 'authentification', '2fa']],
    ['telephone', ['appel', 'sms', 'message']],
    ['téléphone', ['appel', 'sms', 'message']],
    ['colis', ['colis', 'livraison', 'colissimo']],
    ['banque', ['banque', 'bancaire', 'conseiller bancaire', 'virement', 'carte']]
  ]);

  const tokenSynonyms = {
    colis: ['colis', 'livraison', 'colissimo', 'chronopost', 'dhl'],
    livraison: ['livraison', 'colis', 'colissimo'],
    banque: ['banque', 'bancaire', 'conseiller'],
    bancaire: ['bancaire', 'banque', 'conseiller'],
    carte: ['carte', 'bancaire', 'paiement'],
    virement: ['virement', 'banque', 'bancaire'],
    sms: ['sms', 'message', 'texto'],
    message: ['message', 'sms', 'email', 'e-mail'],
    pirate: ['pirate', 'piratage', 'compte', 'authentification'],
    piratage: ['piratage', 'pirate', 'compte', 'authentification'],
    password: ['password', 'mot de passe'],
    arnaque: ['arnaque', 'fraude', 'escroquerie', 'phishing', 'hameçonnage', 'hameconnage']
  };

  function normalize(value = '') {
    return value
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z0-9\s-]/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();
  }

  function words(value = '') {
    return new Set(normalize(value).split(' ').filter((word) => word.length > 1));
  }

  function containsPhrase(haystack, phrase) {
    const source = ` ${normalize(haystack)} `;
    const needle = ` ${normalize(phrase)} `;
    return source.includes(needle);
  }

  function articleFields(article) {
    return {
      title: normalize(article.title),
      description: normalize(article.description),
      category: normalize(article.category),
      tags: normalize((article.tags || []).join(' '))
    };
  }

  function scoreTerm(fields, term) {
    const clean = normalize(term);
    if (!clean) return 0;
    const variants = clean.includes(' ') ? [clean] : (tokenSynonyms[clean] || [clean]);
    let best = 0;

    for (const variant of variants) {
      const isPhrase = variant.includes(' ');
      const titleMatch = isPhrase ? containsPhrase(fields.title, variant) : words(fields.title).has(normalize(variant));
      const tagMatch = isPhrase ? containsPhrase(fields.tags, variant) : words(fields.tags).has(normalize(variant));
      const categoryMatch = isPhrase ? containsPhrase(fields.category, variant) : words(fields.category).has(normalize(variant));
      const descriptionMatch = isPhrase ? containsPhrase(fields.description, variant) : words(fields.description).has(normalize(variant));

      if (titleMatch) best = Math.max(best, 8);
      if (tagMatch) best = Math.max(best, 6);
      if (categoryMatch) best = Math.max(best, 4);
      if (descriptionMatch) best = Math.max(best, 2);
    }
    return best;
  }

  function scoreArticle(article, query) {
    const clean = normalize(query);
    if (!clean) return 0;
    const fields = articleFields(article);

    const intentTerms = intentAliases.get(clean);
    if (intentTerms) {
      return Math.max(...intentTerms.map((term) => scoreTerm(fields, term)));
    }

    const queryTerms = clean.split(' ').filter((term) => term.length > 1);
    const scores = queryTerms.map((term) => scoreTerm(fields, term));
    const matched = scores.filter((score) => score > 0);
    if (!matched.length) return 0;

    const coverage = matched.length / queryTerms.length;
    if (queryTerms.length > 1 && coverage < 0.5) return 0;
    return matched.reduce((total, score) => total + score, 0) + Math.round(coverage * 3);
  }

  function escapeHtml(value = '') {
    return value.replace(/[&<>'"]/g, (char) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#039;', '"': '&quot;'
    }[char]));
  }

  function render(query, updateUrl = false) {
    const clean = normalize(query);
    if (!clean) {
      results.hidden = true;
      results.innerHTML = '';
      if (updateUrl) history.replaceState({}, '', window.location.pathname);
      return;
    }

    const matches = searchArticles
      .map((article) => ({ article, score: scoreArticle(article, query) }))
      .filter((item) => item.score > 0)
      .sort((a, b) => b.score - a.score)
      .slice(0, 6);

    results.hidden = false;
    if (updateUrl) {
      const url = new URL(window.location.href);
      url.searchParams.set('q', query);
      url.hash = 'recherche';
      history.replaceState({}, '', url);
    }

    if (!matches.length) {
      results.innerHTML = `
        <div class="search-empty">
          <strong>Aucun guide trouvé pour « ${escapeHtml(query)} ».</strong>
          <span>Le sujet n'est peut-être pas encore publié. Essayez un mot plus général.</span>
        </div>`;
      return;
    }

    results.innerHTML = matches.map(({ article }) => `
      <a class="search-result" href="/articles/${article.id}/">
        <span class="cat">${escapeHtml(article.category)}</span>
        <strong>${escapeHtml(article.title)}</strong>
        <small>${escapeHtml(article.description)}</small>
      </a>`).join('');
  }

  input?.addEventListener('input', (event) => render(event.target.value));
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    render(input?.value ?? '', true);
  });

  popularButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const query = button.dataset.search || button.textContent?.trim() || '';
      if (input) input.value = button.textContent?.trim() || query;
      render(query, true);
      input?.focus();
    });
  });

  const initialQuery = new URLSearchParams(window.location.search).get('q');
  if (initialQuery) {
    if (input) input.value = initialQuery;
    render(initialQuery);
  }
</script>

<style>
  .hero-search {
    padding: 58px 0 52px;
    background: radial-gradient(circle at 13% 18%, rgba(15,118,110,.12), transparent 31%), linear-gradient(135deg,#eef9f5 0%,#fff9ed 100%);
    border-bottom: 1px solid #eef1ef;
    scroll-margin-top: 82px;
  }
  .hero-content { width: min(980px, calc(100% - 36px)); margin: 0 auto; }
  .hero-search h1 { max-width: 820px; margin: 18px 0 14px; font-size: clamp(2.2rem, 3.7vw, 3.35rem); line-height: 1.03; }
  .hero-search > .hero-content > p { max-width: 720px; margin: 0; color: #4d5e65; font-size: 1.08rem; }
  .search-box { display: flex; max-width: 800px; gap: 10px; margin: 24px 0 16px; }
  .search-box input { flex: 1; min-width: 0; padding: 15px 17px; border: 1px solid #cfdcda; border-radius: 13px; background: #fff; color: var(--ink); outline: none; box-shadow: 0 8px 24px rgba(24,61,56,.07); }
  .search-box input:focus { border-color: var(--brand); box-shadow: 0 0 0 4px rgba(15,118,110,.12); }
  .search-box button { padding: 15px 21px; border: 0; border-radius: 13px; background: var(--brand); color: #fff; font-weight: 850; cursor: pointer; }
  .search-box button:hover { background: var(--brand-dark); }
  .popular-searches { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; color: var(--muted); font-size: .9rem; }
  .popular-searches span { font-weight: 750; color: #435259; }
  .popular-search { padding: 7px 12px; border: 1px solid var(--line); border-radius: 999px; background: rgba(255,255,255,.86); color: var(--ink); cursor: pointer; }
  .popular-search:hover { border-color: #9fc9c4; background: #fff; }
  .search-results { max-width: 800px; margin-top: 14px; padding: 8px; background: #fff; border: 1px solid var(--line); border-radius: 15px; box-shadow: 0 18px 45px rgba(24,61,56,.12); }
  .search-result { display: grid; gap: 3px; padding: 13px 14px; border-radius: 10px; color: var(--ink); text-decoration: none; }
  .search-result:hover { background: var(--soft); }
  .search-result strong { font-size: .98rem; }
  .search-result small { color: var(--muted); }
  .search-empty { display: flex; flex-direction: column; gap: 4px; padding: 15px; color: var(--muted); }
  .search-empty strong { color: var(--ink); }
  [hidden] { display: none !important; }

  @media (min-width: 1100px) {
    .hero-search h1 { white-space: nowrap; }
  }
  @media (max-width: 660px) {
    .hero-search { padding: 42px 0 38px; }
    .hero-content { width: min(980px, calc(100% - 28px)); }
    .hero-search h1 { font-size: clamp(2.15rem, 10vw, 2.8rem); }
    .search-box { flex-direction: column; }
    .search-box button { width: 100%; }
  }
</style>
