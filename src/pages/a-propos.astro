import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="À propos | Réflexe Sûr" description="La mission et la méthode éditoriale de Réflexe Sûr.">
  <div class="pagehero"><div class="wrap"><span class="pill">Notre méthode</span><h1>Comprendre avant d'agir.</h1><p class="lead">Réflexe Sûr transforme des recommandations fiables en guides simples et actionnables.</p></div></div>
  <section><div class="wrap content" style="max-width:800px"><h2>Notre mission</h2><p>Aider les particuliers à reconnaître les arnaques et à protéger leurs comptes et leur argent sans jargon ni sensationnalisme.</p><h2>Comment les guides sont préparés</h2><p>Les informations importantes sont vérifiées auprès de sources officielles ou reconnues, puis reformulées dans un langage accessible. Nous n'inventons ni témoignages ni expériences personnelles.</p><h2>Mises à jour</h2><p>Les articles affichent leur date de publication et, lorsqu'elle existe, leur date de mise à jour. Les procédures susceptibles d'évoluer doivent être revérifiées avant publication.</p></div></section>
</BaseLayout>
